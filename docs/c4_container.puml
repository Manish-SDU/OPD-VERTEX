@startuml c4_container
!include <C4/C4_Container>

' ── Color Palette ──────────────────────────────────
' Actors        = Steel-blue   #3B82F6
' Core app      = Emerald      #059669
' AI services   = Amber/Orange #F59E0B
' Data stores   = Violet       #7C3AED
' External svcs = Rose/Pink    #E11D48
' Utilities     = Teal         #0D9488

!define ACTOR_BG   #3B82F6
!define ACTOR_BRD  #1E40AF
!define CORE_BG    #059669
!define CORE_BRD   #065F46
!define AI_BG      #F59E0B
!define AI_BRD     #B45309
!define DATA_BG    #7C3AED
!define DATA_BRD   #5B21B6
!define EXT_BG     #E11D48
!define EXT_BRD    #9F1239
!define UTIL_BG    #0D9488
!define UTIL_BRD   #115E59

title OPD-VERTEX — Container Diagram (C4 Level 2)

Person(doctor,  "Doctor",  "Conducts consultations", $tags="actor")
Person(admin,   "Admin",   "Manages system config",  $tags="actor")
Person(patient, "Patient", "Views history & Rx",      $tags="actor")

System_Ext(idp,   "External Identity Provider", "Registration &\ncredential management", $tags="ext")
System_Ext(email, "Email Service",              "Prescription delivery", $tags="ext")

System_Boundary(b1, "OPD-VERTEX Platform") {
    Container(web,  "Web Application",      "FastAPI + Jinja2",     "Serves HTML UI, handles\nauthentication, routes requests", $tags="core")
    Container(app,  "Application Services", "Python",               "Orchestrates consultations,\ntranscription, clinical notes,\nprescriptions, review workflows", $tags="core")
    Container(ai_t, "Whisper API",          "FastAPI microservice", "Local speech-to-text\ntranscription service", $tags="ai")
    Container(ai_n, "LLM Adapter",         "Ollama / local LLM",   "Clinical note generation\n& suggestive safety review", $tags="ai")
    ContainerDb(sql, "SQL Database",        "MySQL",                "Staff, patients,\nconsultations, prescriptions,\naudit logs", $tags="data")
    ContainerDb(doc, "Document Store",      "MongoDB",              "Email templates,\nLLM prompts,\ngenerated documents", $tags="data")
    Container(pdf,  "PDF Generator",        "ReportLab",            "Renders prescription PDFs", $tags="util")
}

Rel(doctor,  web, "Uses", "HTTPS")
Rel(admin,   web, "Uses", "HTTPS")
Rel(patient, web, "Uses", "HTTPS")

Rel(web, idp, "Validates tokens")
Rel(web, app, "Delegates to")

Rel(app, ai_t,  "Audio -> transcript")
Rel(app, ai_n,  "Transcript -> notes / Rx")
Rel(app, sql,   "Reads / writes", "SQLAlchemy")
Rel(app, doc,   "Reads / writes", "Motor")
Rel(app, pdf,   "Generates PDFs")
Rel(app, email, "Sends prescriptions", "SMTP")

' ── Tag Styles ─────────────────────────────────
hide stereotype
AddPersonTag("actor",    $bgColor=ACTOR_BG, $borderColor=ACTOR_BRD, $fontColor="#FFFFFF")
AddContainerTag("core",  $bgColor=CORE_BG,  $borderColor=CORE_BRD,  $fontColor="#FFFFFF")
AddContainerTag("ai",    $bgColor=AI_BG,    $borderColor=AI_BRD,    $fontColor="#FFFFFF")
AddContainerTag("data",  $bgColor=DATA_BG,  $borderColor=DATA_BRD,  $fontColor="#FFFFFF")
AddContainerTag("util",  $bgColor=UTIL_BG,  $borderColor=UTIL_BRD,  $fontColor="#FFFFFF")
AddSystemTag("ext",      $bgColor=EXT_BG,   $borderColor=EXT_BRD,   $fontColor="#FFFFFF")

skinparam noteBorderColor #CCCCCC
skinparam noteBackgroundColor #FEFEFE
skinparam noteFontSize 11

note as Legend
  **Legend**
  ----
  <color:#3B82F6><U+25A0><U+25A0></color> **Actor** : Users / Roles
  <color:#059669><U+25A0><U+25A0></color> **Core** : Application Containers
  <color:#F59E0B><U+25A0><U+25A0></color> **AI** : AI / ML Services
  <color:#7C3AED><U+25A0><U+25A0></color> **Data** : Databases
  <color:#0D9488><U+25A0><U+25A0></color> **Util** : Utility Services
  <color:#E11D48><U+25A0><U+25A0></color> **Ext** : External Services
end note

@enduml
